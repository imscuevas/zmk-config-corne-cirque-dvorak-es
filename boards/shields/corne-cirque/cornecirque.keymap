#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            require-prior-idle-ms = <150>;
        };
        ltqa: layer_tap_quick_alpha {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_QUICK_ALPHA";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
            require-prior-idle-ms = <150>;
        };
        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_QUICK";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
            require-prior-idle-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none         &kp DOT       &hm RALT COMMA  &kp SEMI       &kp P        &kp Y   &kp F           &kp G           &kp C          &hm RALT H     &kp L         &kp MINUS
&kp CAPSLOCK  &hm LGUI A    &hm LALT O      &hm LCTRL E    &hm LSHFT U  &kp I   &kp D           &hm RSHFT R     &hm RCTRL T    &hm LALT N     &hm RGUI S    &kp SQT
&none         &ltqa 3 FSLH  &kp Q           &kp J          &kp K        &kp X   &kp B           &kp M           &kp W          &kp V          &ltqa 3 Z     &none
                                            &kp ESCAPE     &ltq 2 SPACE &kp TAB &kp BACKSPACE   &ltq 1 ENTER    &kp DELETE
            >;

            label = "Base";
        };

        num {
            bindings = <
&none&kp APOS    &kp N7      &kp N8  &kp N9      &kp BSLH    &none  &none  &none  &none  &none  &bootloader
&none&kp LBKT    &kp N4      &kp N5  &kp N6      &kp RBKT    &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none  &none
&none   &kp NUBS    &kp N1  &kp N2  &kp N3  &kp GRAVE   &none   &none   &none  &none  &kp RALT  &none  &none
                            &kp EQUAL &kp N0  &kp MINUS   &none   &none   &none
            >;

            label = "Numbers";
        };

        nav {
            bindings = <
&bootloader  &none  &none  &none  &none  &none    &kp LC(Z)     &kp LC(V)       &kp LC(C)       &kp LC(X)       &kp LC(Y)  &none
&none        &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp LEFT  &kp DOWN    &kp UP      &kp RIGHT   &none  &none
&none        &none  &kp RALT  &none  &none  &none    &kp HOME  &kp PG_UP   &kp PG_DN   &kp END     &kp INS  &none
                           &none  &none  &none    &kp BSPC     &kp RET       &kp DEL
            >;

            label = "Navigation";
        };

        mouse {
            bindings = <
&none   &none   &none   &none       &none       &none       &none   &none   &none   &none   &none   &none
&none   &none   &none   &mkp MB4    &mkp MB5    &none       &none   &none   &none   &none   &none   &none
&none   &none   &mo 4   &none       &none       &none       &none   &none   &none   &mo 4   &none   &none
                        &mkp MB3    &mkp MB1    &mkp MB2    &none   &none   &none
            >;

            label = "Mouse";
        };

        scroll {
            bindings = <
&none   &none   &none   &none       &none       &none       &none   &none   &none   &none   &none   &none
&none   &none   &none   &mkp MB4    &mkp MB5    &none       &none   &none   &none   &none   &none   &none
&none   &none   &none   &none       &none       &none       &none   &none   &none   &none   &none   &none
                        &mkp MB3    &mkp MB1    &mkp MB2    &none   &none   &none
            >;

            label = "Scroll";
        };
    };
};
