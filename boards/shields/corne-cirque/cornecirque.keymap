#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        bts0: bluetooth_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>,
                       <&bt BT_SEL 0>;
        };
        bts1: bluetooth_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>,
                       <&bt BT_SEL 1>;
        };
        bts2: bluetooth_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>,
                       <&bt BT_SEL 2>;
        };
        bts3: bluetooth_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>,
                       <&bt BT_SEL 3>;
        };
        bts4: bluetooth_select_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>,
                       <&bt BT_SEL 4>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            require-prior-idle-ms = <150>;
        };
        ltqa: layer_tap_quick_alpha {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_QUICK_ALPHA";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
            require-prior-idle-ms = <150>;
        };
        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_QUICK";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
            require-prior-idle-ms = <0>;
        };
        bt0: bluetooth_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bts0>, <&bt BT_DISC 0>;
        };
        bt1: bluetooth_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bts1>, <&bt BT_DISC 1>;
        };
        bt2: bluetooth_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bts2>, <&bt BT_DISC 2>;
        };
        bt3: bluetooth_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bts3>, <&bt BT_DISC 3>;
        };
        bt4: bluetooth_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bts4>, <&bt BT_DISC 4>;
        };
        btc: bluetooth_clear {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none         &kp DOT       &kp COMMA  &kp SEMI       &kp P        &kp Y   &kp F           &kp G           &kp C          &kp H     &kp L         &kp MINUS
&kp CAPSLOCK  &hm LGUI A    &hm LALT O      &hm LCTRL E    &hm LSHFT U  &kp I   &kp D           &hm RSHFT R     &hm RCTRL T    &hm LALT N     &hm RGUI S    &kp SQT
&none         &ltqa 3 FSLH  &hm RALT Q           &kp J     &kp K        &kp X   &kp B           &kp M           &kp W          &hm RALT V          &ltqa 3 Z     &none
                                            &ltq 7 ESCAPE     &ltq 2 SPACE &kp TAB &ltq 5 BACKSPACE   &ltq 1 ENTER    &ltq 6 DELETE
            >;

            display-name = "Base";
        };

        num {
            bindings = <
&none   &kp APOS    &kp N7      &kp N8  &kp N9      &kp BSLH    &none  &none  &none  &none  &none  &bootloader
&none   &kp LBKT    &kp N4      &kp N5  &kp N6      &kp RBKT    &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&none   &kp NUBS    &kp N1  &kp N2  &kp N3  &kp GRAVE   &none   &none   &none  &kp RALT  &none  &none
                            &kp EQUAL &kp N0  &kp MINUS   &none   &none   &none
            >;

            display-name = "Numbers";
        };

        nav {
            bindings = <
&bootloader  &none  &none  &none  &none  &none    &kp LC(Z)     &kp LC(V)       &kp LC(C)       &kp LC(X)       &kp LC(Y)  &none
&none        &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp LEFT  &kp DOWN    &kp UP      &kp RIGHT   &none  &none
&none        &none  &kp RALT  &none  &none  &none    &kp HOME  &kp PG_DN   &kp PG_UP   &kp END     &kp INS  &none
                           &none  &none  &none    &kp BSPC     &kp RET       &kp DEL
            >;

            display-name = "Nav";
        };

        mouse {
            bindings = <
&none   &none   &none   &none       &none       &none       &none   &none   &none   &none   &none   &none
&none   &none   &none   &mkp MB4    &mkp MB5    &none       &none   &none   &none   &none   &none   &none
&none   &none   &mo 4   &none       &none       &none       &none   &none   &none   &mo 4   &none   &none
                        &mkp MB3    &mkp MB1    &mkp MB2    &mkp MB2   &mkp MB1   &mkp MB3
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&none   &none   &none   &none       &none       &none       &none   &none   &none   &none   &none   &none
&none   &none   &none   &mkp MB4    &mkp MB5    &none       &none   &none   &none   &none   &none   &none
&none   &none   &none   &none       &none       &none       &none   &none   &none   &none   &none   &none
                        &mkp MB3    &mkp MB1    &mkp MB2    &none   &none   &none
            >;

            display-name = "Scroll";
        };

        symbols {
            bindings = <
&none   &kp EQUAL  &kp LS(N1)   &kp RA(LBRC)       &kp RA(RBRC)       &none   &none   &none   &none   &none   &none &none
&none   &kp LS(EQUAL)   &kp LS(MINUS)   &kp LS(8)       &kp LS(9)       &none       &none   &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI   &none
&none   &kp NUBS   &kp LS(NUBS)   &kp RA(APOS)      &kp RA(BSLH)       &none       &none   &none   &none   &none   &none   &none
                        &none       &none       &none       &none   &none   &none
            >;

            display-name = "Symbols";
        };

        function {
            bindings = <
&none   &kp F12   &kp F7   &kp F8       &kp F9       &kp PSCRN       &none   &none   &none   &none   &none   &none
&none   &kp F11   &kp F4   &kp F5       &kp F6       &none       &none   &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI    &none
&none   &kp F10   &kp F1   &kp F2       &kp F3       &none       &none   &none   &none   &none   &kp RALT   &none
                        &none       &kp K_MENU       &none       &none   &none   &none
            >;

            display-name = "Function";
        };

        media {
            bindings = <
&none   &none   &none   &none       &none       &none       &kp C_BRI_MIN   &kp C_BRI_DN   &kp C_BRI_UP   &kp C_BRI_MAX   &kp C_BKLT_TOG   &btc
&none   &none   &none   &none       &none       &none       &kp K_PREV   &kp K_VOL_DN   &kp K_VOL_UP   &kp K_NEXT   &out OUT_USB   &none
&none   &none   &none   &none       &none       &none       &bt0   &bt1   &bt2   &bt3   &bt4   &none
                        &none       &none       &none       &kp K_STOP2   &kp K_PLAY_PAUSE   &kp K_MUTE
            >;

            display-name = "Media";
        };
    };
};
